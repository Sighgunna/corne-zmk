#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define MOUSE 3
#define FUN  4

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
   &kp TAB        &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I     &kp O   &kp P    &kp BSPC
   &mt LCTRL ESC  &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT      &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
             &lt MOUSE LGUI &lt NAV SPACE &lt SYM RET   &lt SYM RET &lt NAV BSPC &lt FUN RALT
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
   &trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp PG_UP &kp HOME &kp UP   &kp END   &kp DEL  &trans
   &trans &kp N6 &kp N7 &kp N8 &kp N9 &kp N0   &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp RET  &trans
   &trans &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(Y)   &kp LC(LEFT) &kp LC(RIGHT) &kp INS &kp CAPS &kp PSCRN &trans
                              &trans &trans &trans   &trans &trans &trans
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
   &trans &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp STAR &kp LPAR &kp RPAR &trans
   &trans &kp GRAVE &kp TILDE &kp MINUS &kp EQUAL &kp PIPE   &kp UNDER &kp PLUS  &kp LBKT &kp RBKT &kp BSLH &trans
   &trans &trans   &trans   &kp LT   &kp GT   &trans      &kp LBRC  &kp RBRC  &kp COMMA &kp DOT &kp FSLH &trans
                              &trans &trans &trans   &trans &trans &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
   &trans &trans &trans &trans &trans &trans   &msc SCRL_UP   &mkp LCLK &mmv MOVE_UP   &mkp RCLK  &mkp MCLK &trans
   &trans &trans &trans &trans &trans &trans   &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mkp MB4 &trans
   &trans &trans &trans &trans &trans &trans   &msc SCRL_LEFT &msc SCRL_RIGHT &trans &trans &mkp MB5 &trans
                              &trans &trans &trans   &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
   &studio_unlock &kp F1 &kp F2  &kp F3  &kp F4  &kp F5    &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
   &bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP &kp F12
   &sys_reset     &bootloader &trans &trans &trans &trans    &trans &kp C_MUTE &kp C_BRI_DN &kp C_BRI_UP &bootloader &sys_reset
                              &trans &trans &trans   &trans &trans &trans
            >;
        };

        extra1 { display-name = "Extra 1"; bindings = <
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans   &trans &trans &trans
            >; };

        extra2 { display-name = "Extra 2"; bindings = <
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans   &trans &trans &trans
            >; };
    };
};
